# Workspace root — passed as cwd to `claude -p`
# Any folder Claude should treat as its working directory (markdown folder, notes app, etc.)
VAULT_ROOT=C:\Users\<you>\path\to\your\folder

# Full path to the claude CLI executable (not on PATH by default on Windows)
# Find it with: Get-ChildItem "$env:APPDATA\Claude" -Recurse -Filter "claude.exe"
# Update the version segment after Claude upgrades
CLAUDE_BIN=C:\Users\<you>\AppData\Roaming\Claude\claude-code\<version>\claude.exe

# Model to use for claude -p (leave empty to use the CLI default)
CLAUDE_MODEL=claude-sonnet-4-6

# Timeout for claude subprocess (seconds)
CLAUDE_TIMEOUT=300

# Host port for the signal-cli-rest-api container (default 8090).
# Change if the port conflicts with another service (e.g. SABnzbd uses 8080).
# Must match the port in SIGNAL_API_URL below.
SIGNAL_API_PORT=8090

# signal-cli-rest-api base URL — must use the same port as SIGNAL_API_PORT above.
SIGNAL_API_URL=http://127.0.0.1:8090

# Your own Signal number in E.164 format (the account paired in PAIRING.md)
SIGNAL_NUMBER=+1234567890

# Comma-separated E.164 numbers allowed to trigger Claude.
# Defaults to SIGNAL_NUMBER — messages from anyone else are silently dropped.
ALLOWED_SENDERS=+1234567890

# Poll interval for /v1/receive in seconds (3 is responsive without hammering the API)
POLL_INTERVAL=3

# Max tokens before classifying as freeform instead of a short research topic
SHORT_TOPIC_MAX_TOKENS=4

# Subfolder (relative to VAULT_ROOT) where research notes are written.
# Must match the folder that contains Signal inbox/CLAUDE.md in your workspace.
SIGNAL_INBOX=Signal inbox

# Attach generated .md files to the Signal reply (true/false)
ATTACH_MD=true

# Number of recent messages to include as context (enables follow-up queries)
HISTORY_DEPTH=5

# --- Intent dispatcher env vars (optional) ---
# The bridge supports config-driven HTTP intents via intents.json
# (copy from intents.example.json — gitignored). Each intent can reference
# ${ENV_VAR} placeholders that are resolved from this file at request time.
# Add whatever vars your intents.json references; nothing here is required
# by the bridge itself. Examples for the shipped Radarr example:
#   RADARR_URL=http://localhost:7878
#   RADARR_API_KEY=
#
# Examples for the shipped Home Assistant TTS announcement intent.
# The intent POSTs to /api/services/script/${HA_TTS_SCRIPT} so all media-player
# sequencing (turn_on + delay + volume + tts.<engine>_say) lives in the HA
# script — the bridge stays generic. Create a script on the HA side that
# accepts a `message` field; see README for an example.
# Mint HA_TOKEN at HA UI -> Profile -> Security -> Long-lived access tokens.
#   HA_URL=http://homeassistant.local:8123
#   HA_TOKEN=
#   HA_TTS_SCRIPT=tts_announce
